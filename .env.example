# Copy this file to .env.local and fill in your values.
# .env.local is gitignored — never commit real keys.

# --- MongoDB (saves each submission) ---
# Get a free cluster at https://www.mongodb.com/atlas → Connect → Drivers.
MONGODB_URI=
MONGODB_DB=rhyam

# --- Resend (emails you each submission) ---
# Get a key at https://resend.com → API Keys.
RESEND_API_KEY=
# Where inquiries are sent, and the from-address they appear under.
# Until you verify your own domain in Resend, keep CONTACT_FROM as the
# onboarding sender and set CONTACT_TO to the email on your Resend account.
CONTACT_TO=hello@rhyamtech.co
CONTACT_FROM=Rhyam Tech Co <onboarding@resend.dev>
